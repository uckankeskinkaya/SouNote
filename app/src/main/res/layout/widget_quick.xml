<?xml version="1.0" encoding="utf-8"?>
<!-- "Hızlı işlemler" widget'ı: hızlı not, son belge, tuval, asistan -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/quick_note"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        android:layout_weight="1"
        android:background="@drawable/widget_chip"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:id="@+id/quick_note_icon"
            android:src="@drawable/ic_w_note"
            android:tint="#FF8DA6FF" />

        <TextView
            android:id="@+id/quick_note_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Hızlı not"
            android:textColor="#F2FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quick_doc"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        android:layout_weight="1"
        android:background="@drawable/widget_chip"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:id="@+id/quick_doc_icon"
            android:src="@drawable/ic_w_doc"
            android:tint="#FF8DA6FF" />

        <TextView
            android:id="@+id/quick_doc_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Son belge"
            android:textColor="#F2FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quick_canvas"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        android:layout_weight="1"
        android:background="@drawable/widget_chip"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:id="@+id/quick_canvas_icon"
            android:src="@drawable/ic_w_canvas"
            android:tint="#FF8DA6FF" />

        <TextView
            android:id="@+id/quick_canvas_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Tuval"
            android:textColor="#F2FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quick_assistant"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        android:layout_weight="1"
        android:background="@drawable/widget_chip"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:id="@+id/quick_assistant_icon"
            android:src="@drawable/ic_w_assistant"
            android:tint="#FF8DA6FF" />

        <TextView
            android:id="@+id/quick_assistant_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Asistan"
            android:textColor="#F2FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
