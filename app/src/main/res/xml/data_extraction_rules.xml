<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: asistan anahtarı bulut yedeğine ve cihaz aktarımına girmesin -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="assistant.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="assistant.xml" />
    </device-transfer>
</data-extraction-rules>
